{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@ptcg/battle-ui": [
        "../../packages/battle-ui/src/index.ts"
      ],
      "@ptcg/platform-services": [
        "../../packages/platform-services/src/index.ts"
      ],
      "@ptcg/battle-protocol": [
        "../../packages/battle-protocol/ts/src/index.ts"
      ],
      "@ptcg/desktop-web/online": [
        "../desktop-web/src/online/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "e2e",
    "playwright.config.ts"
  ]
}
