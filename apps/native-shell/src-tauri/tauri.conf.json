{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PTCG Lab Preview",
  "version": "0.8.0",
  "identifier": "org.ptcglab.desktop.preview",
  "build": {
    "frontendDist": "../ui",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; style-src 'self'; img-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Game",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
