{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@ptcg/battle-ui": [
        "../../packages/battle-ui/src/index.ts"
      ],
      "@ptcg/battle-ui/presentation": [
        "../../packages/battle-ui/src/battle/presentation.ts"
      ]
    }
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    "practice-e2e",
    "playwright.practice.config.ts"
  ]
}
