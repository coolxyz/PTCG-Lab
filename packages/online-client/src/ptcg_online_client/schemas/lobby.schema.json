{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RoomCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": "2.0"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "ruleReleaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deckRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "ruleReleaseId",
        "deckRevision"
      ]
    },
    "RoomJoin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": "2.0"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "inviteCode": {
          "type": "string",
          "pattern": "^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{10}$"
        },
        "deckRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "inviteCode",
        "deckRevision"
      ]
    },
    "RoomDeck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": "2.0"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "expectedRoomVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deckRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "expectedRoomVersion",
        "deckRevision"
      ]
    },
    "RoomReady": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": "2.0"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "expectedRoomVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ready": {
          "type": "boolean"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "expectedRoomVersion",
        "ready"
      ]
    },
    "RoomLeave": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": "2.0"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "expectedRoomVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "expectedRoomVersion"
      ]
    },
    "RoomView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": "2.0"
        },
        "roomId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "roomVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inviteCode": {
          "type": "string",
          "pattern": "^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{10}$"
        },
        "ruleReleaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "waiting",
            "closed",
            "initializing",
            "initialized",
            "technical_abort"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "viewerSeat": {
          "enum": [
            "PLAYER1",
            "PLAYER2"
          ]
        },
        "deckRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seat": {
                "enum": [
                  "PLAYER1",
                  "PLAYER2"
                ]
              },
              "ready": {
                "type": "boolean"
              }
            },
            "required": [
              "seat",
              "ready"
            ]
          }
        },
        "matchId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "protocolVersion",
        "roomId",
        "roomVersion",
        "inviteCode",
        "ruleReleaseId",
        "status",
        "expiresAt",
        "viewerSeat",
        "deckRevision",
        "members",
        "matchId"
      ]
    },
    "RoomLeft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": "2.0"
        },
        "roomId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "roomVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "left": {
          "const": true
        }
      },
      "required": [
        "protocolVersion",
        "roomId",
        "roomVersion",
        "left"
      ]
    },
    "DeckAccepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": "2.0"
        },
        "deckRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "ruleReleaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "formatAsOf": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "protocolVersion",
        "deckRevision",
        "ruleReleaseId",
        "formatAsOf"
      ]
    }
  }
}
