{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptcg-lab:protocol:v2",
  "title": "BattleProtocolV2",
  "description": "P2-D strict v2 development contract; explicit visible presentation fields, no private recovery payload.",
  "oneOf": [
    {
      "$ref": "#/$defs/Command"
    },
    {
      "$ref": "#/$defs/DeckSubmission"
    },
    {
      "$ref": "#/$defs/MatchSnapshot"
    },
    {
      "$ref": "#/$defs/Capabilities"
    },
    {
      "$ref": "#/$defs/ProtocolError"
    },
    {
      "$ref": "#/$defs/ReplayPage"
    }
  ],
  "$defs": {
    "Identifier": {
      "title": "Identifier",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Seat": {
      "title": "Seat",
      "enum": [
        "PLAYER1",
        "PLAYER2"
      ]
    },
    "ProtocolVersion": {
      "title": "ProtocolVersion",
      "enum": [
        "2.0"
      ]
    },
    "DeckEntry": {
      "title": "DeckEntry",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "printingId": {
          "$ref": "#/$defs/Identifier"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "required": [
        "printingId",
        "quantity"
      ]
    },
    "DeckSubmission": {
      "title": "DeckSubmission",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "requestId": {
          "$ref": "#/$defs/Identifier"
        },
        "ruleReleaseId": {
          "$ref": "#/$defs/Identifier"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeckEntry"
          },
          "maxItems": 60,
          "minItems": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "ruleReleaseId",
        "entries"
      ]
    },
    "OptionChoice": {
      "title": "OptionChoice",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optionId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "optionId"
      ]
    },
    "SelectionChoice": {
      "title": "SelectionChoice",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selectedRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 60,
          "uniqueItems": true
        }
      },
      "required": [
        "selectedRefs"
      ]
    },
    "Command": {
      "title": "Command",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "commandId": {
          "$ref": "#/$defs/Identifier"
        },
        "expectedMatchSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedStateVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "controllerEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decisionId": {
          "$ref": "#/$defs/Identifier"
        },
        "choice": {
          "oneOf": [
            {
              "$ref": "#/$defs/OptionChoice"
            },
            {
              "$ref": "#/$defs/SelectionChoice"
            }
          ]
        }
      },
      "required": [
        "protocolVersion",
        "commandId",
        "expectedMatchSeq",
        "expectedStateVersion",
        "controllerEpoch",
        "decisionId",
        "choice"
      ]
    },
    "CardIdentity": {
      "title": "CardIdentity",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cardId": {
          "$ref": "#/$defs/Identifier"
        },
        "printingId": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "presentation": {
          "$ref": "#/$defs/VisibleCardPresentation"
        }
      },
      "required": [
        "cardId",
        "name"
      ]
    },
    "CardState": {
      "title": "CardState",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/Identifier"
        },
        "card": {
          "$ref": "#/$defs/CardIdentity"
        },
        "damage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "hp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "maximumHp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "energy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "maxItems": 120
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardIdentity"
          },
          "maxItems": 60
        },
        "evolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardIdentity"
          },
          "maxItems": 60
        },
        "conditions": {
          "type": "array",
          "items": {
            "enum": [
              "ASLEEP",
              "PARALYZED",
              "CONFUSED",
              "POISONED",
              "BURNED"
            ]
          },
          "maxItems": 5,
          "uniqueItems": true
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "abilityUsed",
              "abilitiesSuppressed",
              "retreatBlocked",
              "attackBlocked",
              "firstTurnPlayed"
            ]
          },
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "ref",
        "card"
      ]
    },
    "VisiblePrize": {
      "title": "VisiblePrize",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "card": {
          "$ref": "#/$defs/CardIdentity"
        }
      },
      "required": [
        "index",
        "card"
      ]
    },
    "OwnSide": {
      "title": "OwnSide",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardState"
          },
          "maxItems": 1
        },
        "bench": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardState"
          },
          "maxItems": 60
        },
        "discard": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardIdentity"
          },
          "maxItems": 60
        },
        "lostZone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardIdentity"
          },
          "maxItems": 60
        },
        "handCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "deckCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "prizeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "faceUpPrizes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VisiblePrize"
          },
          "maxItems": 60
        },
        "benchCapacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "hand": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardIdentity"
          },
          "maxItems": 60
        },
        "id": {
          "enum": [
            "player1",
            "player2"
          ]
        },
        "turnFlags": {
          "$ref": "#/$defs/TurnFlags"
        }
      },
      "required": [
        "active",
        "bench",
        "discard",
        "lostZone",
        "handCount",
        "deckCount",
        "prizeCount",
        "faceUpPrizes",
        "benchCapacity",
        "hand"
      ]
    },
    "OpponentSide": {
      "title": "OpponentSide",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardState"
          },
          "maxItems": 1
        },
        "bench": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardState"
          },
          "maxItems": 60
        },
        "discard": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardIdentity"
          },
          "maxItems": 60
        },
        "lostZone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardIdentity"
          },
          "maxItems": 60
        },
        "handCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "deckCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "prizeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "faceUpPrizes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VisiblePrize"
          },
          "maxItems": 60
        },
        "benchCapacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "hand": {
          "type": "null"
        },
        "id": {
          "enum": [
            "player1",
            "player2"
          ]
        },
        "turnFlags": {
          "$ref": "#/$defs/TurnFlags"
        }
      },
      "required": [
        "active",
        "bench",
        "discard",
        "lostZone",
        "handCount",
        "deckCount",
        "prizeCount",
        "faceUpPrizes",
        "benchCapacity",
        "hand"
      ]
    },
    "Option": {
      "title": "Option",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "actionType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "sourceRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "targetRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "activeRef": {
          "$ref": "#/$defs/Identifier"
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "sourcePosition": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "targetId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "targetPosition": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "active_pokemon": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "active_pokemonId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "active_pokemonPosition": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "active_pokemonRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "ability": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "attack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "damage": {
              "type": "integer",
              "minimum": -100000,
              "maximum": 100000
            }
          },
          "required": [
            "name",
            "damage"
          ]
        },
        "position": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 600
            },
            {
              "type": "null"
            }
          ]
        },
        "targetIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 600
            },
            {
              "type": "null"
            }
          ]
        },
        "active_pokemonIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 600
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 60
        },
        "chosen": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 60
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "integer",
              "minimum": -100000,
              "maximum": 100000
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "required": [
        "id",
        "actionType"
      ]
    },
    "Candidate": {
      "title": "Candidate",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/Identifier"
        },
        "card": {
          "$ref": "#/$defs/CardIdentity"
        },
        "boardRef": {
          "$ref": "#/$defs/Identifier"
        },
        "side": {
          "enum": [
            "self",
            "opponent"
          ]
        },
        "zone": {
          "enum": [
            "active",
            "bench",
            "discard",
            "hand",
            "lostZone",
            "stadium"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "position": {
          "type": "string",
          "maxLength": 128
        },
        "revealedPrizeIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "revealedPrizeSide": {
          "enum": [
            "self",
            "opponent"
          ]
        }
      },
      "required": [
        "ref"
      ]
    },
    "DeckInspection": {
      "title": "DeckInspection",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "enum": [
            "self",
            "opponent"
          ]
        },
        "ordered": {
          "enum": [
            false
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "card": {
                "$ref": "#/$defs/CardIdentity"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            },
            "required": [
              "card",
              "count"
            ]
          },
          "maxItems": 60
        }
      },
      "required": [
        "owner",
        "ordered",
        "total",
        "cards"
      ]
    },
    "OptionsDecision": {
      "title": "OptionsDecision",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "actor": {
          "$ref": "#/$defs/Seat"
        },
        "kind": {
          "enum": [
            "options"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          },
          "maxItems": 2048,
          "minItems": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "id",
        "actor",
        "kind",
        "options"
      ]
    },
    "SelectionDecision": {
      "title": "SelectionDecision",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "actor": {
          "$ref": "#/$defs/Seat"
        },
        "kind": {
          "enum": [
            "selection"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "hidden": {
          "type": "boolean"
        },
        "indexed": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "maxItems": 60
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "deckInspection": {
          "$ref": "#/$defs/DeckInspection"
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "actor",
        "kind",
        "min",
        "max",
        "hidden",
        "indexed",
        "candidates"
      ]
    },
    "Decision": {
      "title": "Decision",
      "oneOf": [
        {
          "$ref": "#/$defs/OptionsDecision"
        },
        {
          "$ref": "#/$defs/SelectionDecision"
        }
      ]
    },
    "VisibleEvent": {
      "title": "VisibleEvent",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "action",
            "setup",
            "reveal",
            "coin",
            "result"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardIdentity"
          },
          "maxItems": 60
        },
        "coins": {
          "type": "array",
          "items": {
            "enum": [
              "heads",
              "tails"
            ]
          },
          "maxItems": 200
        }
      },
      "required": [
        "seq",
        "actor",
        "kind",
        "text"
      ]
    },
    "Observation": {
      "title": "Observation",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "turnNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "self": {
          "$ref": "#/$defs/OwnSide"
        },
        "opponent": {
          "$ref": "#/$defs/OpponentSide"
        },
        "stadium": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardState"
          },
          "maxItems": 1
        },
        "viewer": {
          "enum": [
            "player1",
            "player2"
          ]
        },
        "timestep": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "isChoosingCard": {
          "type": "boolean"
        },
        "terminationReason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "autoEvents": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 256
        }
      },
      "required": [
        "turn",
        "turnNumber",
        "self",
        "opponent",
        "stadium"
      ]
    },
    "MatchSnapshot": {
      "title": "MatchSnapshot",
