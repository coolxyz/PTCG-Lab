{
  "name": "ptcg-lab",
  "version": "1.1.0-preview.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/native-shell",
    "packages/platform-services",
    "apps/desktop-web",
    "packages/battle-ui",
    "packages/battle-protocol/ts",
    "apps/web"
  ],
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.2",
    "vite": "6.4.3"
  },
  "scripts": {
    "protocol:generate": "node scripts/protocol/generate-ts.mjs",
    "practice:build": "npm run build --workspace @ptcg/desktop-web",
    "product:build": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/desktop-web && vite build --config scripts/product/web.config.ts && vite build --config scripts/product/online.config.ts",
    "product:check": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/desktop-web",
    "test:ui": "npm test --workspace @ptcg/desktop-web"
  }
}
