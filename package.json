{
  "name": "ptcg-lab-foundation",
  "version": "0.0.0-p1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop-web",
    "packages/battle-ui",
    "packages/battle-protocol/ts"
  ],
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.2",
    "vite": "6.4.3"
  },
  "scripts": {
    "protocol:generate": "node scripts/protocol/generate-ts.mjs",
    "p3:dev": "npm run dev --workspace @ptcg/desktop-web",
    "p3:build": "npm run build --workspace @ptcg/desktop-web",
    "p3:test": "npm test --workspace @ptcg/desktop-web",
    "p3:product:build": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/desktop-web && vite build --config scripts/migration/p3c_product.config.ts",
    "p3:product:test": "playwright test --config scripts/migration/p3c_playwright.config.ts",
    "p5:build": "tsc --noEmit -p apps/desktop-web && vite build --config scripts/migration/p5c_web.config.ts",
    "product:build": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/desktop-web && vite build --config scripts/product/web.config.ts && vite build --config scripts/migration/p5c_web.config.ts --outDir ../../apps/desktop-web/dist"
  }
}
